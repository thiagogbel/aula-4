{
  "info": {
    "name": "Aula 4 - ViaCEP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar produtos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/product"
      }
    },
    {
      "name": "Disponibilidade - CEP de Mogi",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/product/availability/{{productId}}?cep=08773380",
          "host": ["{{baseUrl}}"],
          "path": ["product", "availability", "{{productId}}"],
          "query": [{ "key": "cep", "value": "08773380" }]
        }
      }
    },
    {
      "name": "Disponibilidade - CEP de Recife",
